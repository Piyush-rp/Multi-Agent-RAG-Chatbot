# Choose: mock | anthropic | openai | groq
LLM_PROVIDER=mock

# Any sentence-transformers model name (downloaded on first use)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only needed if LLM_PROVIDER=groq (free key: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Number of answer samples drawn for the confidence check
N_SAMPLES=3

# How many times the rewriter agent may retry the knowledge base
# before a question is logged as a gap
MAX_RETRIES=1

# Cosine-similarity agreement threshold below which the agent
# treats itself as "uncertain" (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.72

# Hybrid retrieval: dense + BM25 + trigram, fused with Reciprocal Rank Fusion
TOP_K=4
RETRIEVAL_MIN_SIMILARITY=0.3
TRIGRAM_MIN_SCORE=0.2
WEIGHT_DENSE=1.0
WEIGHT_BM25=1.0
WEIGHT_TRIGRAM=0.5

# Where Chroma persists its data
CHROMA_DIR=./data/chroma
GAP_DB_PATH=./data/gaps.db
